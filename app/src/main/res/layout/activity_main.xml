<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    tools:context=".MainActivity"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center">

        <!-- Botón Ejercicio 1 -->
        <Button
            android:id="@+id/btnEjercicio1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 1: Validador URL"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/bton"
            android:textColor="@color/negro"/>

        <!-- Botón Ejercicio 2 -->
        <Button
            android:id="@+id/btnEjercicio2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 2: Navegación Retrasada"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/bton"
            android:textColor="@color/negro"/>

        <!-- Botón Ejercicio 3 -->
        <Button
            android:id="@+id/btnEjercicio3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 3: Layouts Anidados"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/bton"
            android:textColor="@color/negro"/>

        <!-- Botón Ejercicio 4 -->
        <Button
            android:id="@+id/btnEjercicio4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 4: FrameLayout Grilla"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/bton"
            android:textColor="@color/negro"/>

        <!-- Botón Ejercicio 5 -->
        <Button
            android:id="@+id/btnEjercicio5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 5: Calculadora"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/bton"
            android:textColor="@color/negro"/>

        <!-- Botón Ejercicio 6 -->
        <Button
            android:id="@+id/btnEjercicio6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 6: Perfil Usuario"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/bton"
            android:textColor="@color/negro"/>

</LinearLayout>
